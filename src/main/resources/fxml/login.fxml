<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="app.controller.LoginController"
      stylesheets="@../css/styles.css"
      prefWidth="900" prefHeight="540"
      style="-fx-background-color: #e5e5e5; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 8);">

    <!-- Panel izquierdo azul -->
    <VBox styleClass="login-panel-left" prefWidth="380" spacing="0">
        <padding><Insets top="40" left="36" right="36" bottom="28"/></padding>

        <!-- Logo y título -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox styleClass="login-logo-box" alignment="CENTER"
                  style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 8; -fx-padding: 8;">
                <ImageView fx:id="imgLogoLogin" fitWidth="28" fitHeight="28"
                           preserveRatio="true" visible="false" managed="false"/>
                <SVGPath fx:id="svgLogoLogin" styleClass="sidebar-logo-icon"
                         content="M21.9 8.89l-1.05-4.37c-.22-.9-1-1.52-1.91-1.52H5.05c-.9 0-1.69.63-1.9 1.52L2.1 8.89c-.24 1.02-.02 2.06.62 2.88.08.11.19.19.28.29V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-6.94c.09-.09.2-.18.28-.28.64-.82.87-1.87.62-2.89zM18.91 4.99l1.05 4.37c.1.42.01.84-.25 1.17-.14.18-.44.48-.94.48-.61 0-1.14-.49-1.21-1.14L16.98 5l1.93-.01zM13 5h1.96l.54 4.52c.05.39-.07.78-.33 1.07-.22.26-.54.41-.95.41-.67 0-1.22-.59-1.22-1.31V5zM8.49 9.52L9.04 5H11v4.69c0 .72-.55 1.31-1.29 1.31-.34 0-.65-.15-.89-.41-.25-.29-.37-.68-.33-1.07zm-4.45-.16L5.09 5h1.93l-.57 4.86c-.08.65-.6 1.14-1.21 1.14-.49 0-.8-.3-.93-.48-.27-.32-.36-.75-.27-1.16zM6 19v-6.03c.08.01.15.03.23.03.87 0 1.66-.36 2.24-.95.6.6 1.4.95 2.31.95.87 0 1.65-.36 2.23-.93.59.57 1.39.93 2.29.93.84 0 1.64-.35 2.24-.95.58.59 1.37.95 2.24.95.08 0 .15-.02.23-.03V19H6z"/>
            </VBox>
            <VBox spacing="1">
                <Label fx:id="lblNombreNegocioLogin" text="ComercioControl" styleClass="sidebar-title"/>
                <Label fx:id="lblSloganLogin" text="Gestión de inventario" styleClass="sidebar-subtitle"/>
            </VBox>
        </HBox>

        <VBox VBox.vgrow="ALWAYS"/>

        <!-- Características -->
        <VBox spacing="20">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 6; -fx-padding: 6;" alignment="CENTER">
                    <SVGPath styleClass="login-feature-icon" content="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="Control de inventario" styleClass="login-feature-title"/>
                    <Label text="Entradas, salidas y alertas de stock en tiempo real" styleClass="login-feature-desc" wrapText="true"/>
                </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 6; -fx-padding: 6;" alignment="CENTER">
                    <SVGPath styleClass="login-feature-icon" content="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="Punto de venta (POS)" styleClass="login-feature-title"/>
                    <Label text="Registra ventas rápido y genera recibos al instante" styleClass="login-feature-desc" wrapText="true"/>
                </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 6; -fx-padding: 6;" alignment="CENTER">
                    <SVGPath styleClass="login-feature-icon" content="M5 9.2h3V19H5V9.2zM10.6 5h2.8v14h-2.8V5zm5.6 8H19v6h-2.8v-6z"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="Reportes y estadísticas" styleClass="login-feature-title"/>
                    <Label text="Visualiza ventas, utilidades y productos top" styleClass="login-feature-desc" wrapText="true"/>
                </VBox>
            </HBox>
        </VBox>

        <VBox VBox.vgrow="ALWAYS"/>

        <VBox spacing="4" style="-fx-padding: 0;">
            <Label text="v1.0.0 · 2026" styleClass="login-version"/>
        </VBox>
    </VBox>

    <!-- Panel derecho blanco -->
    <VBox styleClass="login-panel-right" HBox.hgrow="ALWAYS" alignment="CENTER">
        <padding><Insets top="40" left="52" right="52" bottom="40"/></padding>

        <VBox spacing="6" style="-fx-padding: 0 0 28 0;">
            <Label text="Bienvenido" styleClass="login-title"/>
            <Label text="Ingresa tus credenciales para continuar" styleClass="login-subtitle"/>
        </VBox>

        <!-- Formulario -->
        <VBox spacing="20">
            <VBox spacing="6">
                <Label text="Usuario" styleClass="login-field-label"/>
                <TextField fx:id="txtUsuario" styleClass="text-field-custom"
                           promptText="Ej: ana.garcia" prefHeight="40"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Contraseña" styleClass="login-field-label"/>
                <PasswordField fx:id="txtPassword" styleClass="text-field-custom"
                               promptText="••••••••" prefHeight="40"/>
            </VBox>

            <Label fx:id="lblError" styleClass="error-label" visible="false" managed="false"
                   text="Usuario o contraseña incorrectos" wrapText="true"/>

            <Button fx:id="btnIngresar" text="Ingresar" styleClass="btn-primary"
                    prefHeight="44" maxWidth="Infinity"
                    onAction="#onIngresar"/>
        </VBox>

        <HBox alignment="CENTER" style="-fx-padding: 20 0 0 0;">
            <Label text="¿No tienes cuenta?  " style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
            <Hyperlink text="Registrarse →" onAction="#irARegistro"
                       style="-fx-text-fill: #2563eb; -fx-font-size: 13px; -fx-border-color: transparent;"/>
        </HBox>
    </VBox>
</HBox>
