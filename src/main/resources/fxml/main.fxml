<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="app.controller.MainController"
      fx:id="rootPane"
      stylesheets="@../css/styles.css"
      styleClass="bg-app"
      prefWidth="1200" prefHeight="700">

    <!-- SIDEBAR -->
    <VBox styleClass="sidebar" spacing="0">
        <padding><Insets top="24" left="16" right="16" bottom="16"/></padding>

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 28 0;">
            <VBox styleClass="sidebar-logo-box" alignment="CENTER" minWidth="32" minHeight="32">
                <SVGPath styleClass="sidebar-logo-icon"
                         content="M21.9 8.89l-1.05-4.37c-.22-.9-1-1.52-1.91-1.52H5.05c-.9 0-1.69.63-1.9 1.52L2.1 8.89c-.24 1.02-.02 2.06.62 2.88.08.11.19.19.28.29V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-6.94c.09-.09.2-.18.28-.28.64-.82.87-1.87.62-2.89zM18.91 4.99l1.05 4.37c.1.42.01.84-.25 1.17-.14.18-.44.48-.94.48-.61 0-1.14-.49-1.21-1.14L16.98 5l1.93-.01zM13 5h1.96l.54 4.52c.05.39-.07.78-.33 1.07-.22.26-.54.41-.95.41-.67 0-1.22-.59-1.22-1.31V5zM8.49 9.52L9.04 5H11v4.69c0 .72-.55 1.31-1.29 1.31-.34 0-.65-.15-.89-.41-.25-.29-.37-.68-.33-1.07zm-4.45-.16L5.09 5h1.93l-.57 4.86c-.08.65-.6 1.14-1.21 1.14-.49 0-.8-.3-.93-.48-.27-.32-.36-.75-.27-1.16zM6 19v-6.03c.08.01.15.03.23.03.87 0 1.66-.36 2.24-.95.6.6 1.4.95 2.31.95.87 0 1.65-.36 2.23-.93.59.57 1.39.93 2.29.93.84 0 1.64-.35 2.24-.95.58.59 1.37.95 2.24.95.08 0 .15-.02.23-.03V19H6z"/>
            </VBox>
            <VBox spacing="1">
                <Label text="ComercioControl" styleClass="sidebar-title" style="-fx-font-size: 14px;"/>
                <Label text="v1.0 · Tienda Retail" styleClass="sidebar-subtitle"/>
            </VBox>
        </HBox>

        <!-- Navegación -->
        <VBox spacing="4">
            <Button fx:id="btnDashboard" styleClass="nav-button, nav-button-active"
                    onAction="#mostrarDashboard" maxWidth="Infinity">
                <graphic><HBox alignment="CENTER_LEFT" spacing="12">
                    <SVGPath styleClass="nav-icon" content="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
                    <Label text="Dashboard" styleClass="nav-label"/>
                </HBox></graphic>
            </Button>
            <Button fx:id="btnInventario" styleClass="nav-button"
                    onAction="#mostrarInventario" maxWidth="Infinity">
                <graphic><HBox alignment="CENTER_LEFT" spacing="12">
                    <SVGPath styleClass="nav-icon" content="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z"/>
                    <Label text="Inventario" styleClass="nav-label"/>
                </HBox></graphic>
            </Button>
            <Button fx:id="btnVentas" styleClass="nav-button"
                    onAction="#mostrarVentas" maxWidth="Infinity">
                <graphic><HBox alignment="CENTER_LEFT" spacing="12">
                    <SVGPath styleClass="nav-icon" content="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                    <Label text="Ventas (POS)" styleClass="nav-label"/>
                </HBox></graphic>
            </Button>
            <Button fx:id="btnClientes" styleClass="nav-button"
                    onAction="#mostrarClientes" maxWidth="Infinity">
                <graphic><HBox alignment="CENTER_LEFT" spacing="12">
                    <SVGPath styleClass="nav-icon" content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    <Label text="Clientes" styleClass="nav-label"/>
                </HBox></graphic>
            </Button>
            <Button fx:id="btnMovimientos" styleClass="nav-button"
                    onAction="#mostrarMovimientos" maxWidth="Infinity">
                <graphic><HBox alignment="CENTER_LEFT" spacing="12">
                    <SVGPath styleClass="nav-icon" content="M6.99 11L3 15l3.99 4v-3H14v-2H6.99v-3zM21 9l-3.99-4v3H10v2h7.01v3L21 9z"/>
                    <Label text="Movimientos" styleClass="nav-label"/>
                </HBox></graphic>
            </Button>
            <Button fx:id="btnProveedores" styleClass="nav-button"
                    onAction="#mostrarProveedores" maxWidth="Infinity">
                <graphic><HBox alignment="CENTER_LEFT" spacing="12">
                    <SVGPath styleClass="nav-icon" content="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                    <Label text="Proveedores" styleClass="nav-label"/>
                </HBox></graphic>
            </Button>
            <Button fx:id="btnCaja" styleClass="nav-button"
                    onAction="#mostrarCaja" maxWidth="Infinity">
                <graphic><HBox alignment="CENTER_LEFT" spacing="12">
                    <SVGPath styleClass="nav-icon" content="M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                    <Label text="Caja" styleClass="nav-label"/>
                </HBox></graphic>
            </Button>
            <Button fx:id="btnReportes" styleClass="nav-button"
                    onAction="#mostrarReportes" maxWidth="Infinity">
                <graphic><HBox alignment="CENTER_LEFT" spacing="12">
                    <SVGPath styleClass="nav-icon" content="M5 9.2h3V19H5V9.2zM10.6 5h2.8v14h-2.8V5zm5.6 8H19v6h-2.8v-6z"/>
                    <Label text="Reportes" styleClass="nav-label"/>
                </HBox></graphic>
            </Button>

            <!-- Solo administrador -->
            <Button fx:id="btnAdminUsuarios" styleClass="nav-button"
                    onAction="#gestionarUsuarios" maxWidth="Infinity">
                <graphic><HBox alignment="CENTER_LEFT" spacing="12">
                    <SVGPath styleClass="nav-icon" content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                    <Label text="Usuarios" styleClass="nav-label"/>
                </HBox></graphic>
            </Button>
            <Button fx:id="btnAuditoria" styleClass="nav-button"
                    onAction="#mostrarAuditoria" maxWidth="Infinity">
                <graphic><HBox alignment="CENTER_LEFT" spacing="12">
                    <SVGPath styleClass="nav-icon" content="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm-2 14l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                    <Label text="Auditoría" styleClass="nav-label"/>
                </HBox></graphic>
            </Button>
        </VBox>

        <VBox VBox.vgrow="ALWAYS"/>

        <!-- Footer usuario -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <VBox style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 20; -fx-min-width: 32; -fx-min-height: 32; -fx-max-width: 32; -fx-max-height: 32;"
                  alignment="CENTER">
                <Label fx:id="lblIniciales" text="AD" styleClass="sidebar-badge"
                       style="-fx-background-color: transparent; -fx-font-size: 12px;"/>
            </VBox>
            <VBox spacing="1" HBox.hgrow="ALWAYS">
                <Label fx:id="lblNombreUsuario" text="Administrador" styleClass="sidebar-footer-label"/>
                <Label fx:id="lblRolUsuario" text="Administrador" styleClass="sidebar-subtitle"/>
            </VBox>
        </HBox>

        <!-- Cerrar sesión -->
        <Button fx:id="btnCerrarSesion" styleClass="nav-button" onAction="#cerrarSesion"
                maxWidth="Infinity">
            <graphic>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <SVGPath content="M16 17v-2H9v-2h7V9l4 4-4 4zM4 5h8V3H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8v-2H4z"
                             styleClass="nav-icon"/>
                    <Label text="Cerrar sesión" styleClass="nav-label"/>
                </HBox>
            </graphic>
            <VBox.margin><Insets top="8"/></VBox.margin>
        </Button>
    </VBox>

    <!-- CONTENIDO PRINCIPAL -->
    <StackPane fx:id="contenidoPrincipal" HBox.hgrow="ALWAYS">
        <padding><Insets top="0" left="0" right="0" bottom="0"/></padding>
    </StackPane>
</HBox>
